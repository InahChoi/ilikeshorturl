# * 서버 포트 (기본값: 3000)
PORT=3000

# * PostgreSQL 연결 URL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ilikeshorturl"

# * JWT 서명 비밀키 (운영 환경에서는 랜덤 문자열로 교체)
JWT_SECRET="change-me-to-a-long-random-secret"

# * JWT 만료 시간
JWT_EXPIRES_IN="7d"

# * 단축 URL 공개 주소 (미설정 시 http://localhost:PORT)
APP_BASE_URL="http://localhost:3000"

# * Google Safe Browsing API 키 (미설정 시 Safe Browsing 검사 생략)
GOOGLE_SAFE_BROWSING_API_KEY=

# * 신규 등록 도메인(NRD) 차단 기준 일수 (0이면 비활성)
URL_SAFETY_NRD_DAYS=30

# * 차단할 TLD 목록 (콤마 구분)
URL_SAFETY_BLOCKED_TLDS=zip,mov

# * 외부 안전 검사 타임아웃(ms)
URL_SAFETY_REQUEST_TIMEOUT_MS=3000
