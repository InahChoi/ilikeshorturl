// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  name         String     @db.VarChar(100)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  shortUrls    ShortUrl[]

  @@map("users")
}

model ShortUrl {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  shortCode   String    @unique @map("short_code") @db.VarChar(32)
  originalUrl String    @map("original_url")
  title       String?   @db.VarChar(255)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  isActive    Boolean   @default(true) @map("is_active")
  clickCount  BigInt    @default(0) @map("click_count")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks      Click[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("short_urls")
}

model Click {
  id         String   @id @default(uuid()) @db.Uuid
  shortUrlId String   @map("short_url_id") @db.Uuid
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  referer    String?
  clickedAt  DateTime @default(now()) @map("clicked_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shortUrl   ShortUrl @relation(fields: [shortUrlId], references: [id], onDelete: Cascade)

  @@index([shortUrlId])
  @@index([clickedAt(sort: Desc)])
  @@map("clicks")
}